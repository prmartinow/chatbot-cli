CHATBOT_CDP_URL=http://127.0.0.1:9222
CHATBOT_WEB_URL=https://example.invalid/
CHATBOT_CDP_CONNECT_TIMEOUT_MS=60000
CHATBOT_PLAYWRIGHT_PACKAGE=rebrowser-playwright-core
CHATBOT_CLI_HOME=/path/to/chatbot-cli
CHATBOT_TRANSCRIPT_DIR=/path/to/private/transcripts
# Optional absolute module override; wins over CHATBOT_PLAYWRIGHT_PACKAGE:
# CHATBOT_PLAYWRIGHT_CORE_PATH=/path/to/node_modules/rebrowser-playwright-core
